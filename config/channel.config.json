{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ak-ai-company.com/schemas/channel.config.json",
  "title": "Channel Configuration",
  "description": "Defines channel identity, visual style, voice, and behavioral presets for the convo-video-engine pipeline. Master Prompt §8 Deliverable 8.",
  "type": "object",
  "required": ["channel_id", "display_name", "niche", "style_slug", "voice", "character", "schedule", "platforms", "gates"],
  "properties": {
    "channel_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique machine-readable identifier (e.g., ai-tech-news, finance-shorts)"
    },
    "display_name": {
      "type": "string",
      "maxLength": 100,
      "description": "Human-readable channel name"
    },
    "niche": {
      "type": "string",
      "enum": ["ai_news", "ai_code", "finance", "health", "policy", "startup", "default"],
      "description": "Content niche - determines hook bias, hashtag pool, and style defaults"
    },
    "style_slug": {
      "type": "string",
      "description": "References styles/registry.json entry (e.g., hud_infographic, split_screen_host, document_drop, data_viz_story, screen_recording_zoompan)"
    },
    "voice": {
      "type": "object",
      "required": ["provider", "model", "reference_wav", "settings"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["indextts2", "voxcpm", "xtts", "piper"],
          "description": "TTS provider"
        },
        "model": {
          "type": "string",
          "description": "Specific model identifier (e.g., indextts2_v1, voxcpm_2026_09)"
        },
        "reference_wav": {
          "type": "string",
          "description": "Path to voice reference WAV file (relative to assets/voices/)"
        },
        "settings": {
          "type": "object",
          "required": ["speed", "pitch", "temperature", "guidance_scale"],
          "properties": {
            "speed": { "type": "number", "minimum": 0.5, "maximum": 2.0, "default": 1.0 },
            "pitch": { "type": "number", "minimum": -12, "maximum": 12, "default": 0 },
            "temperature": { "type": "number", "minimum": 0.1, "maximum": 1.0, "default": 0.3 },
            "guidance_scale": { "type": "number", "minimum": 0.5, "maximum": 5.0, "default": 1.0 }
          }
        },
        "clone_params": {
          "type": "object",
          "description": "Provider-specific cloning parameters",
          "properties": {
            "text": { "type": "string", "description": "Transcription of reference_wav for cloning" },
            "language": { "type": "string", "default": "en" },
            "reference_window_start": { "type": "number", "default": 0 },
            "reference_window_end": { "type": "number", "default": 20 }
          }
        }
      }
    },
    "character": {
      "type": "object",
      "required": ["avatar_image", "presets"],
      "properties": {
        "avatar_image": {
          "type": "string",
          "description": "Path to character avatar image (relative to assets/avatars/)"
        },
        "name": {
          "type": "string",
          "default": "Host"
        },
        "personality": {
          "type": "string",
          "enum": ["analytical", "enthusiastic", "calm", "witty", "authoritative", "curious"],
          "default": "analytical"
        },
        "presets": {
          "type": "object",
          "description": "Reaction and viseme presets - references characterActing.ts",
          "required": ["reactions", "visemes", "idle"],
          "properties": {
            "reactions": {
              "type": "object",
              "description": "Named reaction presets triggered by script markers",
              "additionalProperties": {
                "type": "object",
                "required": ["expression", "duration_frames", "intensity"],
                "properties": {
                  "expression": {
                    "type": "string",
                    "enum": ["surprise", "concern", "agreement", "thinking", "excitement", "skepticism", "neutral"]
                  },
                  "duration_frames": { "type": "integer", "minimum": 1, "maximum": 120 },
                  "intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "trigger_keywords": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "visemes": {
              "type": "object",
              "description": "Viseme mapping for lip-sync (provider-specific)",
              "additionalProperties": {
                "type": "object",
                "required": ["mouth_shape", "duration_ms"],
                "properties": {
                  "mouth_shape": { "type": "string" },
                  "duration_ms": { "type": "integer", "minimum": 50, "maximum": 500 },
                  "blend_frames": { "type": "integer", "default": 3 }
                }
              }
            },
            "idle": {
              "type": "object",
              "required": ["blink_interval", "micro_movements"],
              "properties": {
                "blink_interval": { "type": "number", "minimum": 2.0, "maximum": 8.0, "default": 4.0 },
                "micro_movements": { "type": "boolean", "default": true },
                "breathing": { "type": "boolean", "default": true }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["cadence", "timezone", "publish_times"],
      "properties": {
        "cadence": {
          "type": "string",
          "enum": ["daily", "weekdays", "weekly", "biweekly", "custom"],
          "description": "Publishing cadence"
        },
        "timezone": {
          "type": "string",
          "default": "UTC",
          "description": "IANA timezone (e.g., Asia/Kolkata, America/Los_Angeles)"
        },
        "publish_times": {
          "type": "array",
          "items": { "type": "string", "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$" },
          "minItems": 1,
          "maxItems": 3,
          "description": "Local times to publish (HH:MM format)"
        },
        "custom_cron": {
          "type": "string",
          "description": "Cron expression if cadence=custom"
        }
      }
    },
    "platforms": {
      "type": "object",
      "description": "Per-platform overrides and settings",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:5"] },
          "title_template": { "type": "string" },
          "description_template": { "type": "string" },
          "hashtag_strategy": { "type": "string", "enum": ["niche", "trending", "branded", "mixed"] },
          "thumbnail_strategy": { "type": "string", "enum": ["cover_frame", "custom", "auto"] },
          "privacy_default": { "type": "string", "enum": ["public", "unlisted", "private"] },
          "community_settings": { "type": "object" }
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "Quality gate thresholds - channel-specific overrides",
      "properties": {
        "hook_min_score": { "type": "integer", "minimum": 10, "maximum": 20, "default": 14 },
        "retention_3s_min": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.7 },
        "avd_pct_min": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.5 },
        "completion_pct_min": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.4 },
        "technical_qc": {
          "type": "object",
          "properties": {
            "min_bitrate_kbps": { "type": "integer", "default": 2500 },
            "max_audio_lufs": { "type": "number", "default": -14 },
            "min_audio_lufs": { "type": "number", "default": -20 },
            "required_fps": { "type": "integer", "default": 30 },
            "allowed_resolutions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "brand_kit": {
      "type": "object",
      "description": "Visual brand identity",
      "properties": {
        "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "secondary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "font_primary": { "type": "string" },
        "font_secondary": { "type": "string" },
        "logo_path": { "type": "string" },
        "watermark_path": { "type": "string" },
        "lower_third_template": { "type": "string" }
      }
    },
    "analytics": {
      "type": "object",
      "description": "Analytics and feedback loop settings",
      "properties": {
        "track_retention": { "type": "boolean", "default": true },
        "track_avd": { "type": "boolean", "default": true },
        "track_completion": { "type": "boolean", "default": true },
        "track_shares_saves": { "type": "boolean", "default": true },
        "hook_ab_testing": { "type": "boolean", "default": true },
        "win_rate_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.5 },
        "retire_weak_hooks_after": { "type": "integer", "default": 5 }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Config schema version"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last modification"
    }
  }
}